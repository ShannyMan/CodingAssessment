@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Possible Muddy Weather Forecast</h1>
    <center>
        <form onsubmit="checkForecast(txtLocation, lblOutput, event);">
            <div class="input-group" style="width: 550px; margin: 0 auto;">
                <select id="citySelector" class="form-control" style="width: 180px;" onchange="updateLocationInput(this.value)">
                    <option value="">Select a city</option>
                </select>
                <input placeholder="Enter a city/state" style="width: 300px;" type="text" id="txtLocation" class="form-control" />
                <div class="input-group-append">
                    <button type="button" class="btn btn-outline-secondary" title="Use current location" onclick="getGeolocation(txtLocation, lblOutput)">
                        <i class="fa fa-crosshairs"></i>
                    </button>
                    <button type="submit" class="btn btn-primary">Check Forecast</button>
                </div>
            </div>
        </form>
        <br/>
        <br/>
        <h1 id="lblOutput">Enter a city/state to check the forecast.</h1>
    </center>
</div>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        loadCities();
        getGeolocation(txtLocation, lblOutput);
    });
    
    function loadCities() {
        $.getJSON('api/top-cities')
            .done(function(cities) {
                var selector = document.getElementById('citySelector');
                cities.forEach(function(city) {
                    var option = document.createElement('option');
                    option.value = city;
                    option.text = city;
                    selector.appendChild(option);
                });
            });
    }
    
    function updateLocationInput(cityValue) {
        if (cityValue) {
            document.getElementById('txtLocation').value = cityValue;
            checkForecast(txtLocation, lblOutput, undefined);
        }
    }
    
    // Clear city selector when user manually types in the location field
    document.getElementById('txtLocation').addEventListener('input', function() {
        document.getElementById('citySelector').value = '';
    });
</script>